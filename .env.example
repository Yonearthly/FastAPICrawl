# Application
APP_NAME=AI掘金头条
APP_ENV=development
SECRET_KEY=VTv8aWJSBDCrAwl3NZNO-qQWr_jCzRo6NhqMLPB4fa5hJTmk92fSULjsBZqifoL2
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: the Docker Compose value is supplied automatically.
DATABASE_URL=sqlite:///./data/news.db

# Redis: use redis://redis:6379/0 in Docker.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# OpenAI-compatible LLM
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_API_KEY=sk-iEQjELcQ4hVWjI1XEK0hvHQ5J8YRRmzJBwL10Lu31lD2NZxW
OPENAI_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=60

# Sina crawler and scheduler
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_MINUTES=30
CRAWLER_MAX_ARTICLES=30
CRAWLER_REQUEST_DELAY_SECONDS=0.8
CRAWLER_START_URLS=https://news.sina.com.cn/,https://news.sina.com.cn/china/,https://news.sina.com.cn/world/

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

